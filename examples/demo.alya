## Demo of the toml library
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as toml

function main()
    say "=== Alya TOML Library Demo ==="
    say ""

    # 1. Sample Application Configuration
    let sample_config = "
[package]
name = \"my_service\"
version = \"1.2.0\"
description = \"High performance Alya microservice\"
authors = [\"Alice <alice@example.com>\", \"Bob <bob@example.com>\"]
edition = 2026

[server]
host = \"127.0.0.1\"
port = 8080
workers = 4
debug = true
max_connections = 100_000

[database]
engine = \"sqlite\"
timeout = 30
credentials = { user = \"admin\", pass = \"s3cr3t\" }

[servers.eu_central]
ip = \"192.168.1.10\"
role = \"primary\"
active = true

[servers.us_east]
ip = \"192.168.1.20\"
role = \"replica\"
active = false

[[routes]]
path = \"/api/v1/health\"
methods = [\"GET\"]
auth_required = false

[[routes]]
path = \"/api/v1/users\"
methods = [\"GET\", \"POST\"]
auth_required = true
"

    # 2. Parse TOML String
    say "1. Parsing configuration..."
    let doc = toml::parse(sample_config)
    say "✓ Successfully parsed TOML document!"
    say ""

    # 3. Accessing Top-Level & Table Keys
    say "2. Inspecting package & server settings:"
    let pkg_name = toml::get_str(doc, "package.name")
    let version = toml::get_str(doc, "package.version")
    let host = toml::get_str(doc, "server.host")
    let port = toml::get_int(doc, "server.port")
    let debug_mode = toml::get_bool(doc, "server.debug")
    let max_conns = toml::get_int(doc, "server.max_connections")

    say f"  • Package: {pkg_name} v{version}"
    say f"  • Server:  {host}:{port}"
    say f"  • Debug:   {debug_mode}"
    say f"  • Max Conn:{max_conns}"
    say ""

    # 4. Inline Table Access
    say "3. Reading inline table credentials:"
    let db_user = toml::get_str(doc, "database.credentials.user")
    say f"  • DB User: {db_user}"
    say ""

    # 5. Dotted Table Hierarchy
    say "4. Inspecting multi-region servers:"
    let eu_ip = toml::get_str(doc, "servers.eu_central.ip")
    let eu_role = toml::get_str(doc, "servers.eu_central.role")
    let us_ip = toml::get_str(doc, "servers.us_east.ip")
    let us_role = toml::get_str(doc, "servers.us_east.role")

    say f"  • EU Node: {eu_ip} ({eu_role})"
    say f"  • US Node: {us_ip} ({us_role})"
    say ""

    # 6. Array of Tables
    say "5. Iterating array of tables [[routes]]:"
    let routes = doc["routes"]
    let r_count = len(routes)
    let i = 0
    while i < r_count
        let route = routes[i]
        let r_path = toml::get_str(route, "path")
        let r_auth = toml::get_bool(route, "auth_required")
        let auth_label = "Public"
        if r_auth
            auth_label = "Protected"
        end
        say f"  • Route [{auth_label}]: {r_path}"
        i += 1
    end
    say ""

    # 7. Document Mutation
    say "6. Mutating document in-memory:"
    toml::set(doc, "server.port", 9090)
    toml::set(doc, "server.tls_enabled", true)
    let new_port = toml::get_int(doc, "server.port")
    let tls_flag = toml::get_bool(doc, "server.tls_enabled")
    say f"  • Updated port: {new_port}"
    say f"  • New TLS flag: {tls_flag}"
    say ""

    @cfg(feature = "builder")
    demo_builder()

    say "✓ Demo completed successfully!"
end

@cfg(feature = "builder")
function demo_builder()
    # 8. Programmatic TOML Builder
    say "7. Generating TOML with TomlBuilder:"
    let b = toml::builder()
    toml::builder_add_comment(b, "Generated by demo.alya")
    toml::builder_add_str(b, "app_title", "Microservice Gateway")
    toml::builder_add_int(b, "port", 8080)
    toml::builder_add_bool(b, "ssl", true)
    toml::builder_add_array_str(b, "tags", ["api", "gateway", "alya"])
    toml::builder_add_table(b, "upstream.cluster")
    toml::builder_add_str(b, "endpoint", "https://api.internal")
    toml::builder_add_int(b, "timeout_ms", 2500)

    let out_toml = toml::stringify(b)
    say "----------------------------------------"
    say out_toml
    say "----------------------------------------"
end
main()
