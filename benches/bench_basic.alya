# ═══════════════════════════════════════════════════════════════
# Benchmark suite for toml (benches/bench_basic.alya)
# ═══════════════════════════════════════════════════════════════

import "std/bench"
import "../src/lib.alya" as toml

function main()
    let runner = bench_runner("Alya TOML Package Micro-Benchmarks")

    let sample_toml = "
[server]
host = \"127.0.0.1\"
port = 8080
workers = 4
debug = true

[database]
engine = \"sqlite\"
timeout = 30
credentials = { user = \"admin\", pass = \"secret\" }

[servers.alpha]
ip = \"10.0.0.1\"
role = \"frontend\"
"

    # 1. Parse Benchmark (10,000 iterations)
    bench_start(runner, 10000)
    let i = 0
    while i < 10000
        let doc = toml::parse(sample_toml)
        i += 1
    end
    bench_stop(runner, "toml::parse() 10,000 iterations")

    # 2. Dotted Key Access Benchmark (50,000 lookups)
    let parsed = toml::parse(sample_toml)
    bench_start(runner, 50000)
    let j = 0
    while j < 50000
        let host = toml::get_str(parsed, "server.host")
        let port = toml::get_int(parsed, "server.port")
        let db_user = toml::get_str(parsed, "database.credentials.user")
        let alpha_ip = toml::get_str(parsed, "servers.alpha.ip")
        j += 1
    end
    bench_stop(runner, "toml::get() & get_str/int() 50,000 lookups")

    # 3. TomlBuilder Serialization Benchmark (20,000 iterations)
    bench_start(runner, 20000)
    let k = 0
    while k < 20000
        let b = toml::builder()
        toml::builder_add_str(b, "service", "api_gateway")
        toml::builder_add_int(b, "port", 8080)
        toml::builder_add_bool(b, "tls", true)
        toml::builder_add_table(b, "database")
        toml::builder_add_str(b, "host", "localhost")
        let out = toml::stringify(b)
        k += 1
    end
    bench_stop(runner, "TomlBuilder build + stringify() 20,000 iterations")

    bench_summary(runner)
end

main()
