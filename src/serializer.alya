## # toml/serializer
##
## TOML value formatting and document builder.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Formats strings, keys, scalars, and arrays into TOML syntax, and offers
## a line-buffer builder for sections, tables, and comments.

import "./types.alya"

## Escapes special characters for TOML basic string format.
##
## ### Parameters
## - `s`: Raw string value.
##
## ### Returns
## The double-quoted, escaped TOML string.
pub function format_string(s: string) -> string
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        let c = ord(ch)
        when c
            is 34 then res += "\\\""
            is 92 then res += "\\\\"
            is 10 then res += "\\n"
            is 13 then res += "\\r"
            is 9  then res += "\\t"
            is 8  then res += "\\b"
            is 12 then res += "\\f"
            else res += ch
        end
        i += 1
    end
    return "\"{res}\""
end

## Formats a key, quoting it when it holds non-bare characters.
##
## ### Parameters
## - `k`: Key string.
##
## ### Returns
## The bare or quoted key form.
pub function format_key(k: string) -> string
    let klen = len(k)
    if klen == 0
        return "\"\""
    end
    let needs_quote = 0
    let i = 0
    while i < klen
        let ch = char_at(k, i)
        if is_bare_key_char(ch) == 0
            needs_quote = 1
            break
        end
        i += 1
    end
    if needs_quote == 1
        return format_string(k)
    else
        return k
    end
end

## Formats an integer value.
##
## ### Parameters
## - `n`: Integer value.
##
## ### Returns
## The decimal string form.
pub function format_int(n: int) -> string
    return str(n)
end

## Formats a boolean value.
##
## ### Parameters
## - `b`: Boolean or integer flag.
##
## ### Returns
## `"true"` or `"false"`.
pub function format_bool(b) -> string
    return when b
        is true, 1 => "true"
        else => "false"
    end
end

## Formats a string array (`["a", "b"]`).
##
## ### Parameters
## - `items`: String element array (or null).
##
## ### Returns
## The TOML array literal string.
pub function format_array_str(items: array) -> string
    if items is null or len(items) == 0
        return "[]"
    end
    let res = "["
    let first = 1
    for item in items
        if first == 0
            res += ", "
        end
        first = 0
        res += format_string(item)
    end
    res += "]"
    return res
end

## Formats an integer array (`[1, 2, 3]`).
##
## ### Parameters
## - `items`: Integer element array (or null).
##
## ### Returns
## The TOML array literal string.
pub function format_array_int(items: array) -> string
    if items is null or len(items) == 0
        return "[]"
    end
    let res = "["
    let first = 1
    for item in items
        if first == 0
            res += ", "
        end
        first = 0
        res += str(item)
    end
    res += "]"
    return res
end

## Formats a boolean array (`[true, false]`).
##
## ### Parameters
## - `items`: Boolean element array (or null).
##
## ### Returns
## The TOML array literal string.
pub function format_array_bool(items: array) -> string
    if items is null or len(items) == 0
        return "[]"
    end
    let res = "["
    let first = 1
    for item in items
        if first == 0
            res += ", "
        end
        first = 0
        res += format_bool(item)
    end
    res += "]"
    return res
end

# ───────────────────────────────────────────────────────────────
# TOML Builder API
# ───────────────────────────────────────────────────────────────

## Creates a new empty builder line buffer.
##
## ### Returns
## An empty line array accepting `builder_add_*` entries.
pub function builder_new() -> array
    return []
end

## Appends a `#` comment line to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `comment`: Comment text.
pub function builder_add_comment(b: array, comment: string)
    b.push("# {comment}\n")
end

## Appends a blank line to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
pub function builder_add_blank(b: array)
    b.push("\n")
end

## Appends a `key = "string"` entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `val`: String value.
pub function builder_add_str(b: array, key: string, val: string)
    let fk = format_key(key)
    let fv = format_string(val)
    b.push("{fk} = {fv}\n")
end

## Appends a `key = 123` entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `val`: Integer value.
pub function builder_add_int(b: array, key: string, val: int)
    let fk = format_key(key)
    b.push("{fk} = {val}\n")
end

## Appends a `key = 1.5` entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `val_str`: Pre-formatted float string.
pub function builder_add_float(b: array, key: string, val_str: string)
    let fk = format_key(key)
    b.push("{fk} = {val_str}\n")
end

## Appends a `key = true` entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `val`: Boolean or integer flag.
pub function builder_add_bool(b: array, key: string, val)
    let fk = format_key(key)
    let fv = format_bool(val)
    b.push("{fk} = {fv}\n")
end

## Appends a string array entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `items`: String element array.
pub function builder_add_array_str(b: array, key: string, items: array)
    let fk = format_key(key)
    let fv = format_array_str(items)
    b.push("{fk} = {fv}\n")
end

## Appends an integer array entry to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `key`: Entry key string.
## - `items`: Integer element array.
pub function builder_add_array_int(b: array, key: string, items: array)
    let fk = format_key(key)
    let fv = format_array_int(items)
    b.push("{fk} = {fv}\n")
end

## Appends a `[section]` table header to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `section_name`: Section name string.
pub function builder_add_table(b: array, section_name: string)
    b.push("\n[{section_name}]\n")
end

## Appends a `[[section]]` array-table header to the builder buffer.
##
## ### Parameters
## - `b`: Builder line buffer.
## - `section_name`: Section name string.
pub function builder_add_array_table(b: array, section_name: string)
    b.push("\n[[{section_name}]]\n")
end

## Serializes the builder buffer into a TOML formatted string.
##
## ### Parameters
## - `b`: Builder line buffer (or null).
##
## ### Returns
## The joined TOML document string.
pub function builder_build(b: array) -> string
    if b is null
        return ""
    end
    return join(b, "")
end
