# ═══════════════════════════════════════════════════════════════
# Alya TOML Library (toml)
# Part of the Alya Language Ecosystem (https://github.com/alya-lang)
#
# A zero-dependency TOML v1.0.0 parser and serializer for Alya.
# ═══════════════════════════════════════════════════════════════

import "std/fs"
import "./types.alya"
import "./parser.alya"
import "./serializer.alya"

# 1. Parsing APIs

# Parses a TOML string into a nested map structure
function parse(text)
    return parse_toml(text)
end

# Reads a TOML file from disk and parses it into a map
function load_file(path)
    let content = read_file(path)
    return parse_toml(content)
end

# 2. Accessor Helpers

# Resolves a dot-separated path (e.g. "servers.alpha.ip") in document
function get(doc, path_str)
    let slen = len(path_str)
    let cur = doc
    let seg = ""
    let i = 0
    while i < slen
        let ch = char_at(path_str, i)
        if ch == "."
            if _map_has(cur, seg) == 0
                return null
            end
            cur = cur[seg]
            seg = ""
        else
            seg += ch
        end
        i += 1
    end
    if len(seg) > 0
        if _map_has(cur, seg) == 0
            return null
        end
        return cur[seg]
    end
    return cur
end

# Resolves path and returns trimmed string or default value
function get_str(doc, path_str, default_val = "")
    let val = get(doc, path_str)
    if val == null
        return default_val
    end
    return trim(val)
end

# Resolves path and returns integer or default value
function get_int(doc, path_str, default_val = 0)
    let val = get(doc, path_str)
    if val == null
        return default_val
    end
    return val
end

# Resolves path and returns boolean or default value
function get_bool(doc, path_str, default_val = false)
    let val = get(doc, path_str)
    if val == null
        return default_val
    end
    return val
end

# Checks if a dot-separated path exists in document
function has(doc, path_str)
    let v = get(doc, path_str)
    return v != null
end

# Sets value at dot-separated path in document
function set(doc, path_str, val)
    set_dotted_key_value(doc, path_str, val)
end

# 3. Serialization APIs

# Creates a new empty TomlBuilder
function builder()
    return builder_new()
end

# Serializes builder buffer into TOML formatted string
function stringify(b)
    return builder_build(b)
end

# Writes TOML string directly to a file
function dump_file(path, toml_str)
    return write_file(path, toml_str)
end
